# Required for the Groq-hosted assistant.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Flask session signing key. Replace with a long random value.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Local development OTP. Set false after configuring a working SMTP sender.
OTP_DEVELOPMENT_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional reusable code for one already-registered local admin account.
# Leave blank unless needed. Never use this as production authentication.
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_OTP=

# Optional PostgreSQL persistence. Leave blank to use local CSV/in-process state.
DATABASE_URL=

# The fixed demo date used by order/return examples.
SHOP_TODAY=2026-11-01
